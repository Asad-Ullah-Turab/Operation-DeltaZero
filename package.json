{
  "name": "multiplayer-cylinder",
  "version": "1.0.0",
  "description": "LAN multiplayer 3D cylinder game using TypeScript, Three.js, Cannon-es, and Socket.IO",
  "type": "module",
  "main": "electron-main.cjs",
  "scripts": {
    "dev:client": "vite --host",
    "dev:server": "tsx watch server/index.ts",
    "dev": "concurrently \"npm:dev:server\" \"npm:dev:client\"",
    "build": "tsc --noEmit && vite build",
    "electron:dev": "electron .",
    "app:build:linux": "npm run build && electron-builder --linux AppImage",
    "app:build:win": "npm run build && electron-builder --win portable nsis",
    "app:build:all": "npm run build && electron-builder -lw"
  },
  "dependencies": {
    "cannon-es": "^0.20.0",
    "cors": "^2.8.5",
    "express": "^4.21.0",
    "socket.io": "^4.8.0",
    "socket.io-client": "^4.8.0",
    "three": "^0.170.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^22.0.0",
    "@types/three": "^0.170.0",
    "concurrently": "^9.0.0",
    "electron": "^45.0.0",
    "electron-builder": "^26.15.3",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vite": "^5.4.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "esbuild@0.21.5": true
  },
  "build": {
    "appId": "com.cylinder.game",
    "productName": "MultiplayerCylinder",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron-main.cjs"
    ],
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Game"
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ]
    }
  }
}
