{
  "name": "multiplayer-cylinder",
  "version": "1.0.0",
  "description": "LAN multiplayer 3D cylinder game using TypeScript, Babylon.js, Rapier3D, Colyseus, and Tauri v2",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "server": "tsx watch --tsconfig tsconfig.json server/index.ts",
    "tauri:dev": "tauri dev",
    "tauri:build": "npm run build && tauri build",
    "build:linux": "bash scripts/build-linux.sh",
    "build:win": "bash scripts/build-windows.sh"
  },
  "dependencies": {
    "@babylonjs/core": "^7.0.0",
    "@babylonjs/loaders": "^7.54.3",
    "@colyseus/schema": "^2.0.0",
    "@colyseus/tools": "^0.15.0",
    "@dimforge/rapier3d-compat": "^0.14.0",
    "colyseus": "^0.15.0",
    "colyseus.js": "^0.15.0",
    "cors": "^2.8.5",
    "express": "^4.21.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.0.0",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^22.0.0",
    "concurrently": "^9.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vite": "^6.0.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "esbuild@0.21.5": true
  }
}
